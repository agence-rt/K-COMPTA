{
  "name": "agoa-compta",
  "productName": "AGOA COMPTA",
  "version": "0.1.0",
  "description": "Comptabilité et déclarations de TVA de THOMAS KOCHANSKI ARCHITECTE et de la SCI FAURIEL49",
  "main": "src/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win --x64",
    "e2e": "node tools/e2e.js"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "fr.remithollet.agoa.compta",
    "productName": "AGOA COMPTA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1036"
    },
    "artifactName": "AGOA-COMPTA-Setup-${version}.exe"
  }
}
